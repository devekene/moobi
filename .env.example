NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

TAVILY_API_KEY=

GNEWS_API_KEY=

# Private app store. These Supabase keys stay on the Next.js server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Exact origins, with no paths or trailing slashes. Runtime is a separate service.
MOOBI_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_MINI_APP_RUNTIME_ORIGIN=http://127.0.0.1:4100
# Enable only after applying the migration and configuring the separate runtime.
MOOBI_PRIVATE_PUBLISHING_ENABLED=false

# Public Store: apply the slice 3 migration and configure reviewers before enabling.
MOOBI_PUBLIC_STORE_ENABLED=false
# Comma-separated confirmed Supabase Auth user UUIDs, server-only. No self-review.
MOOBI_STORE_REVIEWER_IDS=
